{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".claude/hooks/block-dangerous.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".claude/hooks/typecheck-after-edit.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(git *)",
            "Bash(npm *)",
            "Read(**)",
            "Edit(app/**)",
            "Edit(components/**)",
            "Edit(lib/**)",
            "Edit(store/**)",
            "Edit(types/**)"
        ],
        "ask": [
            "Bash(git push *)"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(git push --force *)",
            "Bash(curl * | bash)",
            "Bash(wget * | sh)",
            "Edit(.claude/**)",
            "Read(**/.env*)",
            "Read(**/*.key)",
            "Read(**/*.pem)"
        ]
    }
}
